<idea-plugin>
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.bigdatatools.buildSystemBasedStructureProviderFactory"
                    interface="com.jetbrains.bigdatatools.wizard.BuildSystemBasedStructureProviderFactory"
                    dynamic="true"/>

    <extensionPoint qualifiedName="com.intellij.bigdatatools.bdtFrameworkTemplateFactory"
                    interface="com.jetbrains.bigdatatools.wizard.SparkProjectLanguageHandler"
                    dynamic="true"/>

  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <moduleBuilder builderClass="com.jetbrains.bigdatatools.wizard.BdtNewProjectWizardAdapter"/>
  </extensions>
</idea-plugin>