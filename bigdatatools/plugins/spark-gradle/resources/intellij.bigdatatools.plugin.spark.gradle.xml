<idea-plugin package="com.intellij.bigdatatools.plugin.spark.gradle">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.gradle.toolingExtension.impl"/>
    <module name="intellij.platform.codeStyle"/>
    <module name="intellij.platform.codeStyle.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.concurrency"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <bigdatatools.buildSystemBasedStructureProviderFactory
      implementation="com.intellij.bigdatatools.plugin.spark.gradle.projectwizard.SparkGradleStructureProviderFactory"/>
    <bigdatatools.file.selector.initializer implementation="com.intellij.bigdatatools.plugin.spark.gradle.submit.GradleFileSelectorInitializer"/>
    <bigdatatools.file.selector.option implementation="com.intellij.bigdatatools.plugin.spark.gradle.submit.FileSelectorOptionGradle"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
    <projectResolve implementation="com.intellij.bigdatatools.plugin.spark.gradle.submit.ArchiveTaskProjectResolver"/>
  </extensions>
</idea-plugin>