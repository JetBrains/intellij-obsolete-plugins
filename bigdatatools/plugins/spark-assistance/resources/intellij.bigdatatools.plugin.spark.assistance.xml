<idea-plugin package="com.intellij.bigdatatools.plugin.spark.assistance">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.statistics"/>
  </dependencies>
  <!-- endregion -->
  <applicationListeners>
    <listener class="com.intellij.bigdatatools.plugin.spark.assistance.util.SparkAssistanceRegistryListener"
              topic="com.intellij.openapi.util.registry.RegistryValueListener"/>
  </applicationListeners>
  <extensions defaultExtensionNs="com.intellij">
    <registryKey key="spark.dataframe.code.assistance" defaultValue="true"
                 description="Enable code assistance for spark DataFrame schemas" restartRequired="true"/>

    <statistics.counterUsagesCollector
      implementationClass="com.intellij.bigdatatools.plugin.spark.assistance.statistic.SparkStatisticCollector"/>
    <projectSettings service="com.intellij.bigdatatools.plugin.spark.assistance.dfanalysis.inlay.DataframeSampleFileService"/>
  </extensions>
</idea-plugin>