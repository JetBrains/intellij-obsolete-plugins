<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <!--Supported local (i.e. existing in project tree) file types-->
    <fileType implementationClass="com.jetbrains.bigdatatools.view.filetypes.parquet.ParquetFileType"
              fieldName="INSTANCE" name="Parquet" extensions="parquet"/>
    <fileType.fileViewProviderFactory
      filetype="Parquet"
      implementationClass="com.jetbrains.bigdatatools.view.filetypes.parquet.ParquetFileViewProviderFactory"/>
    <fileEditorProvider implementation="com.jetbrains.bigdatatools.view.filetypes.parquet.ParquetEditorProvider"/>
    <filetype.decompiler filetype="Parquet" implementationClass="com.jetbrains.bigdatatools.view.filetypes.RfsCommonFileDecompiler"/>

    <fileType.fileViewProviderFactory filetype="Avro"
                                      implementationClass="com.jetbrains.bigdatatools.view.filetypes.avro.AvroFileViewProviderFactory"/>
    <fileType implementationClass="com.jetbrains.bigdatatools.view.filetypes.avro.AvroFileType"
              fieldName="INSTANCE" name="Avro" extensions="avro"/>
    <fileEditorProvider implementation="com.jetbrains.bigdatatools.view.filetypes.avro.AvroEditorProvider"/>
    <filetype.decompiler filetype="Avro" implementationClass="com.jetbrains.bigdatatools.view.filetypes.RfsCommonFileDecompiler"/>

    <fileType implementationClass="com.jetbrains.bigdatatools.view.filetypes.orc.OrcFileType"
              fieldName="INSTANCE" name="Orc" extensions="orc"/>
    <fileEditorProvider implementation="com.jetbrains.bigdatatools.view.filetypes.orc.OrcEditorProvider"/>
    <filetype.decompiler filetype="Orc" implementationClass="com.jetbrains.bigdatatools.view.filetypes.RfsCommonFileDecompiler"/>

    <fileType implementationClass="com.jetbrains.bigdatatools.view.filetypes.TsvDownloadedFileType"
              fieldName="INSTANCE" name="Tsv(downloaded)" extensions="tsv(downloaded)"/>
    <fileType implementationClass="com.jetbrains.bigdatatools.view.filetypes.CsvDownloadedFileType"
              fieldName="INSTANCE" name="Csv(downloaded)" extensions="Csv(downloaded)"/>
    <!--/file types-->

    <fileEditorProvider implementation="com.jetbrains.bigdatatools.common.table.editor.BdiTableEditorProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij.bigdatatools.rfs">
    <fileMetaInfoProvider implementation="com.jetbrains.bigdatatools.common.rfs.localcache.metainfo.CsvMetaInfoProvider"/>
    <fileMetaInfoProvider implementation="com.jetbrains.bigdatatools.common.rfs.localcache.metainfo.ParquetMetaInfoProvider"/>
    <fileMetaInfoProvider implementation="com.jetbrains.bigdatatools.common.rfs.localcache.metainfo.ORCMetaInfoProvider"/>
    <fileMetaInfoProvider implementation="com.jetbrains.bigdatatools.common.rfs.localcache.metainfo.AvroMetaInfoProvider"/>

    <fileContentDownloader implementation="com.jetbrains.bigdatatools.common.rfs.localcache.filetypes.CsvContentDownloader"/>
    <fileContentDownloader implementation="com.jetbrains.bigdatatools.common.rfs.localcache.filetypes.ParquetContentDownloader"/>
    <fileContentDownloader implementation="com.jetbrains.bigdatatools.common.rfs.localcache.filetypes.ORCContentDownloader"/>
    <fileContentDownloader implementation="com.jetbrains.bigdatatools.common.rfs.localcache.filetypes.AvroDownloader"/>

    <rfsFileTypeViewer implementation="com.jetbrains.bigdatatools.common.rfs.localcache.filetypes.OrcFileViewer"/>
    <rfsFileTypeViewer implementation="com.jetbrains.bigdatatools.common.rfs.localcache.filetypes.AvroViewer"/>
    <rfsFileTypeViewer implementation="com.jetbrains.bigdatatools.common.rfs.localcache.filetypes.ParquetFileViewer"/>
  </extensions>

  <actions resource-bundle="messages.BinaryFilesSupportBundle">
    <group id="BDTShowDDL">
      <add-to-group group-id="Console.EditorTableResult.Group" anchor="last"/>
      <action id="BDI.Console.TableResult.ShowParquetDdl"
              class="com.jetbrains.bigdatatools.common.editor.decorator.actions.ShowParquetDdlAction"
              icon="com.jetbrains.bigdatatools.common.BigdatatoolsCoreIcons.Table.Ddl"/>
      <action id="BDI.Console.TableResult.LoadFullFile"
              class="com.jetbrains.bigdatatools.common.editor.decorator.actions.LoadFullFileAction"
              icon="AllIcons.Actions.Download"/>
    </group>
  </actions>
</idea-plugin>
