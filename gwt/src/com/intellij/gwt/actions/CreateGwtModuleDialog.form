<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.intellij.gwt.actions.CreateGwtModuleDialog">
  <grid id="747b3" binding="myContentPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="111"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="27dc6" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="b571c" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <labelFor value="b99eb"/>
              <text resource-bundle="messages/GwtBundle" key="new.module.dlg.prompt"/>
            </properties>
          </component>
          <component id="b99eb" class="javax.swing.JTextField" binding="myGwtModuleNameField">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="1" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="4a73c" class="javax.swing.JCheckBox" binding="myCreateHtmlFileCheckBox">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <selected value="true"/>
              <text resource-bundle="messages/GwtBundle" key="checkbox.create.html.and.css.files.in.directory"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="69cc0" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="empty">
          <size top="0" left="15" bottom="0" right="0"/>
        </border>
        <children>
          <component id="b88cf" class="com.intellij.ui.ComboboxWithBrowseButton" binding="myHtmlDirectoryPathField">
            <constraints border-constraint="Center"/>
            <properties/>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
