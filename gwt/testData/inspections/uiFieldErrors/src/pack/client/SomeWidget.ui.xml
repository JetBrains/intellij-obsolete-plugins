<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:ppp='urn:import:ppp.client'>

  <div ui:field='unresolvedField'>
    <span ui:field="fieldWithoutAnnotation"/>
    <span ui:field="privateField"/>
    <span ui:field="fieldWithWrongType"/>

    <span ui:field="duplicatedField"/>
    <span ui:field="duplicatedField"/>

    <g:Button ui:field="myButton"/>
    <g:Button ui:field="fieldInBaseClass"/>

    <g:IsWidget ui:field="myProvidedFieldOfSubType"/>
    <g:IsWidget ui:field="myIncorrectFieldOfSubType"/>
    <g:Button ui:field="myFieldOfSuperType"/>
    <g:Button ui:field="myIncorrectProvidedFieldOfSuperType"/>

    <sup ui:field="elementWithoutSpecialClass"/>
  </div>
</ui:UiBinder>