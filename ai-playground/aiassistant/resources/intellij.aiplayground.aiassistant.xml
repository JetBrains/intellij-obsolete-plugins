<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.aiplayground.models"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.core"/>
  </dependencies>
  <!-- endregion -->

  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.aiplayground.aiAssistantModelsProvider"
                    interface="com.intellij.aiplayground.aiassistant.AIAssistantModelsProvider"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <aiplayground.llmServiceProvider implementation="com.intellij.aiplayground.aiassistant.AiAssistantLlmService$Extension"/>
  </extensions>
</idea-plugin>